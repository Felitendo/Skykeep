{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quince",
  "version": "0.1.0",
  "identifier": "dev.quince.client",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Quince",
        "width": 1040,
        "height": 720,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "theme": null
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Your iCloud, on this computer",
    "longDescription": "Quince keeps your iCloud calendar, reminders, photos and notes on your own machine, so they open instantly and work offline. Independent project, not affiliated with Apple."
  }
}
