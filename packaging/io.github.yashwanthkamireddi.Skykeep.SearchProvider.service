# Lets the session bus start Skykeep, hidden in the tray (--background), when GNOME Shell or
# KRunner searches and it is not already running. Installed to /usr/share/dbus-1/services/.
# The Flatpak manifest installs it with Exec pointing into /app instead.
[D-BUS Service]
Name=io.github.yashwanthkamireddi.Skykeep.SearchProvider
Exec=/usr/bin/skykeep --background
