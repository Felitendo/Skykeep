{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quince",
  "version": "0.1.0",
  "identifier": "dev.quince.client",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Quince",
        "width": 1040,
        "height": 720,
        "minWidth": 480,
        "minHeight": 400,
        "resizable": true,
        "center": true,
        "visible": false,
        "theme": null
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "shortDescription": "Your iCloud, on this computer",
    "longDescription": "Quince keeps your iCloud calendar, reminders, photos and notes on your own machine, so they open instantly and work offline. Independent project, not affiliated with Apple.",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/YashwanthKamireddi/quince",
    "publisher": "Yashwanth Kamireddi",
    "linux": {
      "deb": {
        "depends": [
          "libsecret-1-0"
        ],
        "desktopTemplate": "../packaging/dev.quince.client.desktop.in",
        "files": {
          "/usr/share/metainfo/dev.quince.client.metainfo.xml": "../packaging/dev.quince.client.metainfo.xml"
        }
      },
      "rpm": {
        "depends": [
          "libsecret"
        ],
        "desktopTemplate": "../packaging/dev.quince.client.desktop.in",
        "files": {
          "/usr/share/metainfo/dev.quince.client.metainfo.xml": "../packaging/dev.quince.client.metainfo.xml"
        }
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "mainBinaryName": "quince"
}
