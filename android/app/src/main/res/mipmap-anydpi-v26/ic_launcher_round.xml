<?xml version="1.0" encoding="utf-8"?>
<!-- Skykeep's approved logo (packaging/icons/skykeep-1024.png) inside the adaptive icon's safe
     zone, on its own light tone. No monochrome layer: the logo's silhouette alone is a blob, so
     themed icons show it in colour. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
