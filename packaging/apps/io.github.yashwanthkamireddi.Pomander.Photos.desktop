# One of Pomander's six apps, on its own in the launcher. Its window says this file's name as
# its app ID (src-tauri/src/apps.rs), so a dock shows it as this app. All six run in one
# Pomander: one sign-in, one library.
[Desktop Entry]
Type=Application
Name=Photos
GenericName=Photos for iCloud
Comment=iCloud Photos, on this computer
Exec=pomander --app photos
Icon=io.github.yashwanthkamireddi.Pomander
Terminal=false
Categories=Office;
Keywords=Pomander;iCloud;pictures;images;gallery;
StartupNotify=true
StartupWMClass=io.github.yashwanthkamireddi.Pomander.Photos
