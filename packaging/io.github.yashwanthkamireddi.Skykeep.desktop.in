# The menu entry, with the names filled in by whatever is building the package — Tauri
# substitutes these itself, and the Arch PKGBUILD fills them in with sed. One file, so the
# entry cannot say one thing in a .deb and another in a .pkg.tar.zst.
# MimeType: calendar and contact files open in Skykeep's import sheet (src-tauri/src/intake.rs);
# %U hands them over as file:// URIs, which intake reads.
[Desktop Entry]
Type=Application
Name={{name}}
GenericName=iCloud Client
Comment={{comment}}
Exec={{exec}} %U
Icon={{icon}}
Terminal=false
Categories={{categories}}
Keywords=iCloud;calendar;reminders;notes;contacts;sync;
MimeType=text/calendar;text/vcard;text/x-vcard;
StartupNotify=true
StartupWMClass=io.github.yashwanthkamireddi.Skykeep
Actions=new-reminder;new-note;notes;reminders;calendar;contacts;drive;photos;

[Desktop Action new-reminder]
Name=New Reminder
Exec={{exec}} --new reminder

[Desktop Action new-note]
Name=New Note
Exec={{exec}} --new note

[Desktop Action notes]
Name=Notes
Exec={{exec}} --app notes

[Desktop Action reminders]
Name=Reminders
Exec={{exec}} --app reminders

[Desktop Action calendar]
Name=Calendar
Exec={{exec}} --app calendar

[Desktop Action contacts]
Name=Contacts
Exec={{exec}} --app contacts

[Desktop Action drive]
Name=Drive
Exec={{exec}} --app drive

[Desktop Action photos]
Name=Photos
Exec={{exec}} --app photos
