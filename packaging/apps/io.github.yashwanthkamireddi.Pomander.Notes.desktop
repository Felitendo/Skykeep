# One of Pomander's six apps, on its own in the launcher. Its window says this file's name as
# its app ID (src-tauri/src/apps.rs), so a dock shows it as this app. All six run in one
# Pomander: one sign-in, one library.
[Desktop Entry]
Type=Application
Name=Notes
GenericName=Notes for iCloud
Comment=Notes from iCloud, on this computer
Exec=pomander --app notes
Icon=io.github.yashwanthkamireddi.Pomander
Terminal=false
Categories=Office;
Keywords=Pomander;iCloud;notes;memo;
StartupNotify=true
Actions=new-note;
StartupWMClass=io.github.yashwanthkamireddi.Pomander.Notes

# A quick capture: one field, Enter, and it is in iCloud (src-tauri/src/intake.rs).
[Desktop Action new-note]
Name=New Note
Exec=pomander --new note
