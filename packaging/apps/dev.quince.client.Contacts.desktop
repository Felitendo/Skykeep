# One of Pomander's six apps, on its own in the launcher. Its window says this file's name as
# its app ID (src-tauri/src/apps.rs), so a dock shows it as this app. All six run in one
# Pomander: one sign-in, one library.
[Desktop Entry]
Type=Application
Name=Contacts
GenericName=Contacts for iCloud
Comment=Your iCloud contacts, on this computer
Exec=pomander --app contacts
Icon=dev.quince.client
Terminal=false
Categories=Office;
Keywords=Pomander;iCloud;people;address;
StartupNotify=true
StartupWMClass=dev.quince.client.Contacts
