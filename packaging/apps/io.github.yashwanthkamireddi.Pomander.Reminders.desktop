# One of Pomander's six apps, on its own in the launcher. Its window says this file's name as
# its app ID (src-tauri/src/apps.rs), so a dock shows it as this app. All six run in one
# Pomander: one sign-in, one library.
[Desktop Entry]
Type=Application
Name=Reminders
GenericName=Reminders for iCloud
Comment=Reminders from iCloud, on this computer
Exec=pomander --app reminders
Icon=io.github.yashwanthkamireddi.Pomander
Terminal=false
Categories=Office;
Keywords=Pomander;iCloud;todo;tasks;lists;
StartupNotify=true
Actions=new-reminder;
StartupWMClass=io.github.yashwanthkamireddi.Pomander.Reminders

# A quick capture: one field, Enter, and it is in iCloud (src-tauri/src/intake.rs).
[Desktop Action new-reminder]
Name=New Reminder
Exec=pomander --new reminder
