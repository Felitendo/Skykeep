# One of Pomander's six apps, on its own in the launcher. Its window says this file's name as
# its app ID (src-tauri/src/apps.rs), so a dock shows it as this app. All six run in one
# Pomander: one sign-in, one library.
[Desktop Entry]
Type=Application
Name=Calendar
GenericName=Calendar for iCloud
Comment=Your iCloud calendars, on this computer
Exec=pomander --app calendar
Icon=io.github.yashwanthkamireddi.Pomander
Terminal=false
Categories=Office;
Keywords=Pomander;iCloud;events;schedule;
StartupNotify=true
StartupWMClass=io.github.yashwanthkamireddi.Pomander.Calendar
