<?xml version="1.0" encoding="utf-8"?>
<!-- Reminders, synced with the account like Contacts and Calendar (RemindersSync.kt). -->
<sync-adapter xmlns:android="http://schemas.android.com/apk/res/android"
    android:contentAuthority="io.github.yashwanthkamireddi.skykeep.reminders"
    android:accountType="io.github.yashwanthkamireddi.skykeep.account"
    android:userVisible="true"
    android:supportsUploading="true"
    android:allowParallelSyncs="false"
    android:isAlwaysSyncable="true" />
